{
  "name": "personal-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "validate": "node scripts/validate-content.mjs",
    "validate:strict": "node scripts/validate-content.mjs --strict",
    "check:links": "node scripts/check-links.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "sync:github": "node scripts/sync-github.mjs",
    "ci": "npm run lint && npm run test && npm run validate && npm run build && npm run check:size && npm run check:routes"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
